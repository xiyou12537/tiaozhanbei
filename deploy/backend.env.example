JWT_SECRET=replace-with-a-random-production-secret
LEGACY_PLATFORM_ROUTERS_ENABLED=false
PYTHONUNBUFFERED=1
MPLCONFIGDIR=/tmp/matplotlib
# 4-core / 3.6 GiB production profile: one chemistry job per Uvicorn process.
MOLECULAR_COMPUTE_MAX_CONCURRENT=1
# Accepted Study/Scan background work waits at most this long for the slot.
MOLECULAR_COMPUTE_QUEUE_TIMEOUT_SECONDS=900
